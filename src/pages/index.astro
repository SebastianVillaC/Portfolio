---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Timeline from "../components/Timeline.astro";
import Projects from "../components/Projects.astro";
import Certifications from "../components/Certifications.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import Stack from "../components/Stack.astro";

const title = "Sebas.DevSec | Software Developer & Cybersecurity Enthusiast";
const description =
  "Portfolio personal de Sebastián - Desarrollador de Software y Ciberseguridad. Especializado en desarrollo seguro, arquitecturas backend y análisis de vulnerabilidades.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main-content">
    <Hero />
    <About />
    <Timeline />
    <Projects />
    <Stack />
    <Certifications />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
