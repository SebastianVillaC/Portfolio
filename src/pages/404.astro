---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getLang, useTranslations } from "../i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const title = "404: Objetivo No Encontrado | Sebas.DevSec";
const description = "Error 404: La página que buscas no existe o ha sido bloqueada.";
---

<BaseLayout title={title} description={description}>
  <Header />

  <main id="main-content" class="px-6 py-16 md:py-28 max-w-4xl mx-auto flex-1 flex flex-col items-center justify-center text-center">
    <!-- Cyberpunk Error Card -->
    <div class="w-full max-w-2xl p-8 rounded-2xl border border-red-500/40 bg-(--bg-secondary)/80 backdrop-blur-md shadow-2xl shadow-red-500/5 space-y-6" data-reveal>
      <!-- Titlebar -->
      <div class="flex items-center justify-between pb-4 border-b border-(--border-color)">
        <div class="flex gap-2">
          <span class="w-3 h-3 rounded-full bg-red-500 inline-block animate-pulse"></span>
          <span class="w-3 h-3 rounded-full bg-yellow-500 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-zinc-700 inline-block"></span>
        </div>
        <span class="text-xs font-mono text-red-400 font-semibold">SECURITY_EXCEPTION: 404_NOT_FOUND</span>
      </div>

      <!-- Terminal Output -->
      <div class="font-mono text-left text-xs sm:text-sm space-y-2 text-(--text-secondary) bg-(--bg-primary) p-4 rounded-xl border border-(--border-color)">
        <p class="text-red-400">&gt; GET /requested_resource HTTP/1.1</p>
        <p class="text-(--text-muted)">&gt; Host: sebastianvillac.github.io</p>
        <p class="text-yellow-400">&gt; Status: 404 Target Not Found</p>
        <p class="text-(--text-secondary)">&gt; Reason: Endpoint was either purged, moved, or blocked by defensive rules.</p>
        <p class="text-(--accent-green) pt-2">&gt; Fallback recommended: Return to safe perimeter.</p>
      </div>

      <!-- Actions -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a
          href="/Portfolio/"
          class="btn btn-primary w-full sm:w-auto px-7 py-3 text-sm font-bold shadow-lg shadow-(--accent-cyan)/10 hover:-translate-y-0.5"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>{t("404.backHome")}</span>
        </a>

        <a
          href="/Portfolio/projects"
          class="btn btn-secondary w-full sm:w-auto px-7 py-3 text-sm font-semibold hover:-translate-y-0.5"
        >
          <span>{t("404.viewProjects")}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
