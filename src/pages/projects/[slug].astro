---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getLang, useTranslations } from "../../i18n/utils";

export async function getStaticPaths() {
  const projects = await getCollection("projects", (entry) => entry.data.lang === "es");
  return projects.map((project) => {
    const slug = project.id.replace(/[-.]?(es|en)(\.md)?$/i, "");
    return {
      params: { slug },
      props: { project },
    };
  });
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const title = `${data.title} | Sebas.DevSec`;
const description = data.description;

const categoryLabels: Record<string, string> = {
  cybersecurity: "Ciberseguridad",
  backend: "Backend",
  fullstack: "Fullstack",
  tools: "Herramientas",
};
---

<BaseLayout title={title} description={description}>
  <Header />

  <main id="main-content" class="px-6 py-12 md:py-20 max-w-5xl mx-auto flex-1">
    <!-- Back to catalog -->
    <div class="mb-8" data-reveal>
      <a
        href="/Portfolio/projects"
        class="inline-flex items-center gap-2 text-xs font-mono text-(--text-secondary) hover:text-(--accent-cyan) transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>~/projects/catalog</span>
      </a>
    </div>

    <!-- Article Header -->
    <header class="space-y-6 pb-8 border-b border-(--border-color)" data-reveal>
      <div class="flex flex-wrap items-center gap-3">
        <span class="badge-devsec text-xs font-mono uppercase tracking-wider">
          {categoryLabels[data.category] ?? data.category}
        </span>
        {data.featured && (
          <span class="text-xs font-mono text-(--accent-green) bg-(--accent-green)/10 px-2.5 py-0.5 rounded-full border border-(--accent-green)/20 font-medium">
            ★ Proyecto Destacado
          </span>
        )}
      </div>

      <h1 class="text-[clamp(2rem,1.5rem+2.5vw,3.25rem)] font-extrabold text-(--text-primary) tracking-tight leading-tight">
        {data.title}
      </h1>

      <p class="text-base md:text-lg text-(--text-secondary) leading-relaxed">
        {data.description}
      </p>

      <!-- Action buttons -->
      <div class="flex flex-wrap gap-4 pt-2">
        {data.github && (
          <a
            href={data.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-(--border-color) hover:border-(--accent-cyan) bg-(--bg-secondary) text-sm font-semibold text-(--text-primary) hover:text-(--accent-cyan) transition-all hover:-translate-y-0.5"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
            <span>{t("projects.repoLabel")}</span>
          </a>
        )}
        {data.demo && (
          <a
            href={data.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-(--accent-green) text-(--bg-primary) text-sm font-bold hover:brightness-110 shadow-lg shadow-(--accent-green)/10 transition-all hover:-translate-y-0.5"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            <span>{t("projects.demoLabel")}</span>
          </a>
        )}
      </div>
    </header>

    <!-- Project Metadata Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-10" data-reveal>
      <!-- Technologies -->
      <div class="p-5 rounded-xl border border-(--border-color) bg-(--bg-secondary)/60 space-y-3">
        <h3 class="text-xs font-mono uppercase tracking-wider text-(--accent-cyan)">
          {t("projects.techLabel")}
        </h3>
        <ul class="flex flex-wrap gap-1.5">
          {data.tech.map((tech: string) => (
            <li class="px-2.5 py-1 rounded-md bg-(--bg-primary) border border-(--border-color) text-xs font-mono text-(--text-secondary)">
              {tech}
            </li>
          ))}
        </ul>
      </div>

      <!-- Highlights -->
      {data.highlights && (
        <div class="p-5 rounded-xl border border-(--border-color) bg-(--bg-secondary)/60 space-y-3 md:col-span-2">
          <h3 class="text-xs font-mono uppercase tracking-wider text-(--accent-green)">
            Puntos Clave & Capacidades
          </h3>
          <ul class="space-y-2 text-xs sm:text-sm text-(--text-secondary)">
            {data.highlights.map((h: string) => (
              <li class="flex items-start gap-2">
                <span class="text-(--accent-green) font-bold">✓</span>
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <!-- Markdown Content Body -->
    <article class="prose prose-invert max-w-none space-y-6 pt-4 text-(--text-secondary) leading-relaxed" data-reveal>
      <Content />
    </article>

    <!-- Bottom Navigation CTA -->
    <div class="mt-16 pt-8 border-t border-(--border-color) flex flex-col sm:flex-row items-center justify-between gap-4" data-reveal>
      <a
        href="/Portfolio/projects"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-(--border-color) bg-(--bg-secondary) text-xs font-mono text-(--text-primary) hover:border-(--accent-cyan) transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>{t("projects.backToProjects")}</span>
      </a>

      <a
        href="/Portfolio/#contact"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-(--accent-cyan)/10 border border-(--accent-cyan)/30 text-(--accent-cyan) text-xs font-mono font-semibold hover:bg-(--accent-cyan)/20 transition-colors"
      >
        <span>¿Te interesa este proyecto? Contáctame</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
