---
import { getCollection } from "astro:content";
import BlogCard from "./BlogCard.astro";
import { getLang, useTranslations } from "../i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

// Most recent posts first; the full archive lives in /blog
const posts = (await getCollection("blog", (entry) => entry.data.lang === lang))
  .sort(
    (a, b) =>
      new Date(b.data.publishDate).getTime() -
      new Date(a.data.publishDate).getTime(),
  )
  .slice(0, 3);

const blogHref = lang === "en" ? "/Portfolio/en/blog" : "/Portfolio/blog";
---

{
  posts.length > 0 && (
    <section id="blog" class="border-b border-(--border-color)">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-24">
        <header class="mb-14 text-center" data-reveal>
          <p class="font-mono text-xs text-(--accent-cyan) mb-2 tracking-wide">~/blog</p>
          <h2>{t("blog.heading")}</h2>
          <p class="mt-3 text-(--text-secondary) max-w-xl mx-auto text-sm sm:text-base">
            {t("blog.homeDescription")}
          </p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post, index) => (
            <BlogCard post={post} delay={index * 100} />
          ))}
        </div>

        {/* Navegar al Blog Completo */}
        <div class="mt-14 text-center" data-reveal>
          <a
            href={blogHref}
            class="btn btn-soft px-7 py-3.5 font-mono text-sm font-semibold shadow-lg hover:-translate-y-0.5"
          >
            <span>{t("blog.viewAll")}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
        </div>
      </div>
    </section>
  )
}
