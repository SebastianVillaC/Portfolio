---
import { getLang, useTranslations } from "../i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const email = "sebasvilla106@gmail.com";
---

<section id="contact" class="relative">
  <div class="max-w-7xl mx-auto px-6 py-16 md:py-24">
    <header class="mb-14 text-center" data-reveal>
      <p class="font-mono text-xs text-(--accent-cyan) mb-2 tracking-wide">~/contact</p>
      <h2>{t("contact.heading")}</h2>
      <p class="mt-3 text-(--text-secondary) max-w-xl mx-auto text-sm sm:text-base">
        {t("contact.description")}
      </p>
    </header>

    <div class="max-w-3xl mx-auto space-y-6" data-reveal>
      <!-- Contact Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Email Link -->
        <a 
          aria-label={t("contact.emailAriaLabel")}
          href={`mailto:${email}`}
          class="flex flex-col items-center justify-center gap-3 p-6 border border-(--border-color) rounded-xl bg-(--bg-secondary)/80 backdrop-blur-sm card-glow transition-all text-center group"
        >
          <div class="w-12 h-12 rounded-full bg-(--accent-cyan)/10 text-(--accent-cyan) flex items-center justify-center group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>
          <span class="font-bold text-sm text-(--text-primary) group-hover:text-(--accent-cyan) transition-colors">
            {t("contact.emailLabel")}
          </span>
          <span class="text-xs text-(--text-muted) font-mono truncate max-w-[180px]">
            {email}
          </span>
        </a>

        <!-- GitHub Profile -->
        <a 
          aria-label={t("contact.githubAriaLabel")}
          href="https://github.com/SebastianVillaC" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex flex-col items-center justify-center gap-3 p-6 border border-(--border-color) rounded-xl bg-(--bg-secondary)/80 backdrop-blur-sm card-glow transition-all text-center group"
        >
          <div class="w-12 h-12 rounded-full bg-(--accent-green)/10 text-(--accent-green) flex items-center justify-center group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
              <path d="M9 18c-4.51 2-5-2-7-2"/>
            </svg>
          </div>
          <span class="font-bold text-sm text-(--text-primary) group-hover:text-(--accent-green) transition-colors">
            {t("contact.githubLabel")}
          </span>
          <span class="text-xs text-(--text-muted) font-mono">
            @SebastianVillaC
          </span>
        </a>

        <!-- LinkedIn Profile -->
        <a 
          aria-label={t("contact.linkedinAriaLabel")}
          href="https://www.linkedin.com/in/sebastian-villa-c/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex flex-col items-center justify-center gap-3 p-6 border border-(--border-color) rounded-xl bg-(--bg-secondary)/80 backdrop-blur-sm card-glow transition-all text-center group"
        >
          <div class="w-12 h-12 rounded-full bg-(--accent-cyan)/10 text-(--accent-cyan) flex items-center justify-center group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect width="4" height="12" x="2" y="9"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </div>
          <span class="font-bold text-sm text-(--text-primary) group-hover:text-(--accent-cyan) transition-colors">
            {t("contact.linkedinLabel")}
          </span>
          <span class="text-xs text-(--text-muted) font-mono">
            in/sebastian-villa-c
          </span>
        </a>
      </div>

      <!-- Copy email button -->
      <div class="flex justify-center pt-2">
        <button
          id="copy-email-btn"
          type="button"
          data-email={email}
          data-copied-text={t("contact.copied")}
          data-default-text={t("contact.copyEmail")}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-(--border-color) bg-(--bg-secondary) hover:border-(--accent-cyan) text-xs font-mono font-semibold text-(--text-secondary) hover:text-(--text-primary) transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-(--accent-cyan)"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
          <span id="copy-text-target">{t("contact.copyEmail")}</span>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  function initCopyEmail() {
    const btn = document.getElementById("copy-email-btn");
    const target = document.getElementById("copy-text-target");
    if (!btn || !target) return;

    btn.addEventListener("click", async () => {
      const email = btn.dataset.email ?? "";
      const copiedText = btn.dataset.copiedText ?? "¡Copiado!";
      const defaultText = btn.dataset.defaultText ?? "Copiar correo";

      try {
        await navigator.clipboard.writeText(email);
        target.textContent = copiedText;
        btn.classList.add("border-(--accent-green)", "text-(--accent-green)");

        setTimeout(() => {
          target.textContent = defaultText;
          btn.classList.remove("border-(--accent-green)", "text-(--accent-green)");
        }, 2000);
      } catch (e) {
        console.error("Failed to copy", e);
      }
    });
  }

  document.addEventListener("astro:page-load", initCopyEmail);
</script>