---
import { getCollection } from "astro:content";
import ProjectsCard from "./ProjectsCard.astro";
import { getLang, useTranslations } from "../i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const allProjects = await getCollection("projects", (entry) => entry.data.lang === lang);
// Prioritize featured projects on landing
const featuredProjects = allProjects.filter((p) => p.data.featured !== false);
const displayProjects = featuredProjects.length > 0 ? featuredProjects : allProjects;
const allProjectsHref = lang === "en" ? "/Portfolio/en/projects" : "/Portfolio/projects";
---

<section id="projects" class="border-b border-(--border-color)">
  <div class="max-w-7xl mx-auto px-6 py-16 md:py-24">
    <header class="mb-14 text-center" data-reveal>
      <p class="font-mono text-xs text-(--accent-cyan) mb-2 tracking-wide">~/projects</p>
      <h2>{t("projects.heading")}</h2>
      <p class="mt-3 text-(--text-secondary) max-w-xl mx-auto text-sm sm:text-base">
        {lang === "es"
          ? "Selección de proyectos destacados en desarrollo de software seguro y herramientas técnicas."
          : "Featured software engineering and offensive/defensive security tools."}
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        displayProjects.map((pro, index) => (
          <ProjectsCard project={pro} delay={index * 100} />
        ))
      }
    </div>

    <!-- Navegar al Catálogo Completo -->
    <div class="mt-14 text-center" data-reveal>
      <a
        href={allProjectsHref}
        class="btn btn-soft px-7 py-3.5 font-mono text-sm font-semibold shadow-lg hover:-translate-y-0.5"
      >
        <span>{t("projects.viewAll")}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17 8l4 4m0 0l-4 4m4-4H3"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</section>
