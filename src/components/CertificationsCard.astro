---
import { getLang, useTranslations } from "../i18n/utils";

const { certification, delay = 0 } = Astro.props;
const { data } = certification;

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const label = `${t("certifications.viewAriaLabelPrefix")} ${data.title}`;
---

<a
  href={data.url ?? "#certifications"}
  aria-label={label}
  target={data.url ? "_blank" : undefined}
  rel={data.url ? "noopener noreferrer" : undefined}
  class="w-full flex flex-col justify-between border border-(--border-color) rounded-xl p-6 bg-(--bg-secondary)/80 backdrop-blur-sm card-glow transition-all group"
  data-reveal
  style={`transition-delay: ${delay}ms`}
>
  <div class="space-y-2">
    <div class="flex items-center justify-between">
      <span class="text-xs font-mono font-semibold text-(--accent-cyan)">
        {data.year}
      </span>
      {data.url && (
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-(--text-muted) group-hover:text-(--accent-cyan) transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      )}
    </div>

    <h3 class="text-base font-bold text-(--text-primary) group-hover:text-(--accent-cyan) transition-colors">
      {data.title}
    </h3>
  </div>

  <p class="text-xs text-(--text-secondary) font-mono mt-4 pt-3 border-t border-(--border-color)/60">
    {data.issuer}
  </p>
</a>
