---
import { Image } from "astro:assets";
import { getLang, useTranslations } from "../i18n/utils";

const { project, delay = 0 } = Astro.props;
const { data, id } = project;

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

// Extract clean slug without locale extension
const slug = id.replace(/[-.]?(es|en)(\.md)?$/i, "");
const projectDetailHref = lang === "en" ? `/Portfolio/en/projects/${slug}` : `/Portfolio/projects/${slug}`;

const categoryLabels: Record<string, string> = {
  cybersecurity: lang === "es" ? "Ciberseguridad" : "Cybersecurity",
  backend: "Backend",
  fullstack: "Fullstack",
  tools: lang === "es" ? "Herramientas" : "Tools",
};
---

<article
  class="flex flex-col justify-between border border-(--border-color) bg-(--bg-secondary)/60 backdrop-blur-sm rounded-xl p-6 space-y-5 card-glow transition-all"
  data-reveal
  style={`transition-delay: ${delay}ms`}
>
  <div class="space-y-4">
    <!-- Header with Category and Title -->
    <div class="space-y-2">
      <div class="flex items-center justify-between gap-2">
        <span class="badge-devsec text-[0.7rem] uppercase tracking-wider">
          {categoryLabels[data.category] ?? data.category}
        </span>
        {data.featured && (
          <span class="text-[0.7rem] font-mono text-(--accent-green-strong) bg-(--accent-green)/10 px-2 py-0.5 rounded-full border border-(--accent-green)/30 font-medium">
            ★ {lang === "es" ? "Destacado" : "Featured"}
          </span>
        )}
      </div>

      <h3 class="text-xl font-bold text-(--text-primary) hover:text-(--accent-cyan) transition-colors">
        <a href={projectDetailHref}>{data.title}</a>
      </h3>
    </div>

    {
      data.image && (
        <div class="-mx-6 overflow-hidden rounded-md border-y border-(--border-color)">
          <Image
            src={data.image}
            alt={data.title}
            class="w-full h-44 object-cover hover:scale-105 transition-transform duration-500"
            width={480}
            height={240}
          />
        </div>
      )
    }

    <p class="text-(--text-secondary) text-sm leading-relaxed whitespace-pre-line">
      {data.description}
    </p>

    <!-- Highlights preview if available -->
    {
      data.highlights && data.highlights.length > 0 && (
        <ul class="space-y-1.5 pt-1 text-xs text-(--text-secondary)">
          {data.highlights.slice(0, 2).map((highlight: string) => (
            <li class="flex items-start gap-2">
              <span class="text-(--accent-cyan) font-bold">›</span>
              <span>{highlight}</span>
            </li>
          ))}
        </ul>
      )
    }

    <!-- Tech Badges -->
    <div>
      <h4 class="text-xs font-mono text-(--text-muted) uppercase tracking-wider mb-2.5">
        {t("projects.techLabel")}
      </h4>
      <ul class="flex flex-wrap gap-1.5">
        {
          data.tech.map((tech: string) => (
            <li class="px-2.5 py-1 bg-(--bg-primary) border border-(--border-color) rounded-md text-xs font-mono text-(--text-secondary)">
              {tech}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- Action Links -->
  <div class="pt-4 border-t border-(--border-color) space-y-3">
    <!-- View details button -->
    <a
      href={projectDetailHref}
      class="btn btn-secondary w-full py-2 px-4 rounded-lg text-xs font-mono font-semibold"
    >
      <span>{t("projects.viewDetails")}</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>

    <!-- External links -->
    <nav class="flex gap-2" aria-label="Enlaces rápidos del proyecto">
      {
        data.github && (
          <a
            href={data.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t("projects.repoAriaLabel")}
            class="btn btn-secondary flex-1 px-3 py-1.5 rounded-lg text-xs font-medium"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
            <span>{t("projects.repoLabel")}</span>
          </a>
        )
      }
      {
        data.demo && (
          <a
            href={data.demo}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t("projects.demoAriaLabel")}
            class="btn btn-soft flex-1 px-3 py-1.5 rounded-lg text-xs font-semibold"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            <span>{t("projects.demoLabel")}</span>
          </a>
        )
      }
    </nav>
  </div>
</article>
