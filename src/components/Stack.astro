---
import { getCollection } from "astro:content";
import StackCard from "./StackCard.astro";
import { getLang, useTranslations } from "../i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const stack = await getCollection("stack", (entry) => entry.data.lang === lang);
---

<section id="stack" class="border-b border-(--border-color)">
  <div class="max-w-7xl mx-auto px-6 py-16 md:py-24">
    <header class="mb-12 text-center" data-reveal>
      <p class="font-mono text-xs text-(--accent-cyan) mb-2 tracking-wide">~/stack</p>
      <h2>{t("stack.heading")}</h2>
      <p class="mt-4 text-(--text-secondary)">
        {t("stack.description")}
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {stack.map((category, index) => (
        <StackCard category={category} delay={index * 100} />
      ))}
    </div>
  </div>
</section>
